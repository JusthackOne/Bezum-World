generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum EquipmentSlotType {
  HELMET
  ARMOR
  PANTS
  BOOTS
  LEFT_HAND
  RIGHT_HAND
  ACCESSORY
}

enum GameEventType {
  PURCHASE
  BATTLE
  TASK_COMPLETED
}

enum TaskSuggestionStatus {
  pending
  processed
  winner
}

enum BattleEventResult {
  WIN
  LOSE
}

enum BattleAttribute {
  strength
  charisma
  endurance
  intelligence
}

enum BossBattleStatus {
  DRAFT
  SCHEDULED
  ACTIVE
  DEFEATED
  EXPIRED
  CANCELLED
  FINALIZING
  COMPLETED
}

enum BossRewardClaimStatus {
  NOT_ELIGIBLE
  AVAILABLE
  PROCESSING
  CLAIMED
  FAILED
}

enum CivilizationGameStatus {
  DRAFT
  SCHEDULED
  ACTIVE
  COMPLETED
  CANCELLED
}

enum CivilizationCompletionReason {
  TOWN_HALL_CAPTURED
  END_TIME_REACHED
  ADMIN_FORCE_COMPLETED
  ADMIN_CANCELLED
}

enum CivilizationTeamSide {
  TEAM_A
  TEAM_B
}

enum CivilizationTerrainType {
  GROUND
  MOUNTAIN
}

enum CivilizationBuildingType {
  TOWN_HALL
  GOLD_BUILDING
  ATTRIBUTE_BUILDING
}

enum CivilizationBuildingStatus {
  ACTIVE
  CAPTURED
}

enum CivilizationTowerStatus {
  UNDER_CONSTRUCTION
  ACTIVE
  DESTROYED
  CANCELLED
}

enum CivilizationTowerWorkKind {
  BUILD
  REPAIR
}

enum CivilizationActionType {
  MOVE
  ATTACK_PLAYER
  CONTRIBUTE_BUILDING_CAPTURE
  START_TOWER_CONSTRUCTION
  ATTACK_TOWER
  REPAIR_TOWER
  CONTRIBUTE_TOWN_HALL_CAPTURE
  DEFEND_TOWN_HALL
  CATAPULT_ATTACK
}

enum CivilizationEventType {
  GAME_CREATED
  GAME_SCHEDULED
  GAME_STARTED
  GAME_COMPLETED
  GAME_CANCELLED
  PLAYER_ASSIGNED
  PLAYER_ADDED_AFTER_START
  PLAYER_MOVED
  TILE_CAPTURED
  PLAYER_ATTACKED
  PLAYER_DEFEATED
  PLAYER_RESPAWNED
  BUILDING_CAPTURE_STARTED
  BUILDING_CAPTURE_PROGRESS
  BUILDING_CAPTURED
  GOLD_ACCRUED
  ATTRIBUTE_ACCRUED
  TOWER_CONSTRUCTION_STARTED
  TOWER_CONSTRUCTION_CANCELLED
  TOWER_COMPLETED
  TOWER_DESTROYED
  TOWER_REPAIR_STARTED
  TOWER_REPAIRED
  TOWN_HALL_CAPTURE_PROGRESS
  TOWN_HALL_DEFENDED
  TOWN_HALL_CAPTURED
  TEAM_GOLD_SPENT
  REWARDS_DISTRIBUTED
  REWARD_CLAIMED
  CATAPULT_ATTACKED
  ADMIN_STATE_CORRECTION
}

enum CivilizationRewardResourceType {
  GOLD
  ATTRIBUTE
}

enum CivilizationAdminActionType {
  GAME_CREATED
  GAME_UPDATED
  GAME_SCHEDULED
  PLAYER_ASSIGNED
  PLAYER_ADDED_AFTER_START
  MAP_UPDATED
  SETTINGS_UPDATED
  GAME_CANCELLED
  GAME_FORCE_COMPLETED
  STATE_CORRECTED
}

enum CivilizationAttributeKey {
  strength
  charisma
  endurance
  intelligence
}

enum CivilizationGameSnapshotType {
  STARTED
  FINAL
}

model Account {
  id                  String                   @id @default(uuid())
  username            String                   @unique
  avatarUrl           String?
  balance             Int                      @default(0)
  gameScore           Int                      @default(0)
  strength            Int                      @default(0)
  charisma            Int                      @default(0)
  endurance           Int                      @default(0)
  intelligence        Int                      @default(0)
  lastTimeLoggedIn    DateTime?                @db.Timestamptz(3)
  createdAt           DateTime                 @default(now()) @db.Timestamptz(3)
  authCode            AuthCode?
  items               Item[]
  equipment           UserEquipmentSlot[]
  taskSubmissions     TaskSubmission[]
  taskSuggestions     TaskSuggestion[]         @relation("TaskSuggestionCreator")
  taskSuggestionVotes TaskSuggestionVote[]     @relation("TaskSuggestionVoter")
  attackedBattles     BattleLog[]              @relation("BattleAttacker")
  defendedBattles     BattleLog[]              @relation("BattleDefender")
  wonBattles          BattleLog[]              @relation("BattleWinner")
  lostBattles         BattleLog[]              @relation("BattleLoser")
  dailyBattlesAsOne   DailyBattle[]            @relation("DailyBattlePlayerOne")
  dailyBattlesAsTwo   DailyBattle[]            @relation("DailyBattlePlayerTwo")
  purchaseEvents      GameEvent[]              @relation("GameEventPurchaseUser")
  challengedEvents    GameEvent[]              @relation("GameEventChallenger")
  opponentEvents      GameEvent[]              @relation("GameEventOpponent")
  wonEvents           GameEvent[]              @relation("GameEventWinner")
  taskCompletedEvents GameEvent[]              @relation("GameEventTaskCompletedUser")
  bossAttacks         BossAttack[]
  bossParticipants    BossBattleParticipant[]
  bossResults         BossBattleResult[]
  bossRewardClaims    BossRewardClaim[]
  slotStatistics      SlotStatistics?
  civilizationPlayers CivilizationGamePlayer[]
}

model SlotStatistics {
  userId        String   @id @map("user_id")
  totalWinnings Int      @default(0) @map("total_winnings")
  totalLosses   Int      @default(0) @map("total_losses")
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  user          Account  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("slot_statistics")
}

model BossBattle {
  id                    String                  @id @default(uuid())
  name                  String
  description           String?
  imageUrl              String?                 @map("image_url")
  startsAt              DateTime                @map("starts_at") @db.Timestamptz(3)
  endsAt                DateTime                @map("ends_at") @db.Timestamptz(3)
  initialHp             Int                     @map("initial_hp")
  currentHp             Int                     @map("current_hp")
  totalAppliedDamage    Int                     @default(0) @map("total_applied_damage")
  defaultDamage         Int                     @map("default_damage")
  strength              Int
  charisma              Int
  endurance             Int
  intelligence          Int
  attackCooldownSeconds Int                     @map("attack_cooldown_seconds")
  status                BossBattleStatus        @default(DRAFT)
  defeatedAt            DateTime?               @map("defeated_at") @db.Timestamptz(3)
  finishedAt            DateTime?               @map("finished_at") @db.Timestamptz(3)
  resultsFinalizedAt    DateTime?               @map("results_finalized_at") @db.Timestamptz(3)
  version               Int                     @default(1)
  rewardsEnabled        Boolean                 @default(true) @map("rewards_enabled")
  createdAt             DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)
  rewards               BossBattleReward[]
  attacks               BossAttack[]
  participants          BossBattleParticipant[]
  results               BossBattleResult[]
  claims                BossRewardClaim[]
  auditLogs             BossBattleAuditLog[]

  @@index([status, startsAt])
  @@index([status, endsAt])
  @@map("boss_battles")
}

model BossBattleReward {
  id              String                  @id @default(uuid())
  bossBattleId    String                  @map("boss_battle_id")
  placeFrom       Int                     @map("place_from")
  placeTo         Int                     @map("place_to")
  goldAmount      Int                     @default(0) @map("gold_amount")
  gameScoreAmount Int                     @default(0) @map("game_score_amount")
  strength        Int                     @default(0)
  charisma        Int                     @default(0)
  endurance       Int                     @default(0)
  intelligence    Int                     @default(0)
  createdAt       DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)
  battle          BossBattle              @relation(fields: [bossBattleId], references: [id], onDelete: Cascade)
  itemTemplate    BossRewardItemTemplate?
  results         BossBattleResult[]
  claims          BossRewardClaim[]

  @@index([bossBattleId, placeFrom, placeTo])
  @@map("boss_battle_rewards")
}

model BossRewardItemTemplate {
  id                 String            @id @default(uuid())
  bossBattleRewardId String            @unique @map("boss_battle_reward_id")
  name               String
  description        String?
  imageUrl           String?           @map("image_url")
  slotType           EquipmentSlotType @map("slot_type")
  rarity             ItemRarity
  price              Int               @default(0)
  durability         Int?
  strength           Int?
  charisma           Int?
  agility            Int?
  intelligence       Int?
  metadata           Json?
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  reward             BossBattleReward  @relation(fields: [bossBattleRewardId], references: [id], onDelete: Cascade)

  @@map("boss_reward_item_templates")
}

model BossAttack {
  id                     String     @id @default(uuid())
  bossBattleId           String     @map("boss_battle_id")
  userId                 String     @map("user_id")
  calculatedDamage       Int        @map("calculated_damage")
  appliedDamage          Int        @map("applied_damage")
  userPower              Float      @map("user_power")
  bossPower              Float      @map("boss_power")
  randomMultiplier       Float      @map("random_multiplier")
  userAttributesSnapshot Json       @map("user_attributes_snapshot")
  bossAttributesSnapshot Json       @map("boss_attributes_snapshot")
  formulaIdentifier      String     @map("formula_identifier")
  formulaVersion         Int        @map("formula_version")
  attackedAt             DateTime   @map("attacked_at") @db.Timestamptz(3)
  cooldownSlot           DateTime   @map("cooldown_slot") @db.Timestamptz(3)
  createdAt              DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  battle                 BossBattle @relation(fields: [bossBattleId], references: [id], onDelete: Restrict)
  user                   Account    @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([bossBattleId, userId, cooldownSlot])
  @@index([bossBattleId, attackedAt])
  @@index([bossBattleId, userId, attackedAt(sort: Desc)])
  @@map("boss_attacks")
}

model BossBattleParticipant {
  id               String     @id @default(uuid())
  bossBattleId     String     @map("boss_battle_id")
  userId           String     @map("user_id")
  totalDamage      Int        @default(0) @map("total_damage")
  attacksCount     Int        @default(0) @map("attacks_count")
  firstAttackAt    DateTime   @map("first_attack_at") @db.Timestamptz(3)
  lastAttackAt     DateTime   @map("last_attack_at") @db.Timestamptz(3)
  lastCooldownSlot DateTime   @map("last_cooldown_slot") @db.Timestamptz(3)
  nextAttackAt     DateTime   @map("next_attack_at") @db.Timestamptz(3)
  createdAt        DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  battle           BossBattle @relation(fields: [bossBattleId], references: [id], onDelete: Restrict)
  user             Account    @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([bossBattleId, userId])
  @@index([bossBattleId, totalDamage(sort: Desc)])
  @@map("boss_battle_participants")
}

model BossBattleResult {
  id                String                @id @default(uuid())
  bossBattleId      String                @map("boss_battle_id")
  userId            String                @map("user_id")
  place             Int
  totalDamage       Int                   @map("total_damage")
  attacksCount      Int                   @map("attacks_count")
  firstAttackAt     DateTime              @map("first_attack_at") @db.Timestamptz(3)
  lastAttackAt      DateTime              @map("last_attack_at") @db.Timestamptz(3)
  rewardId          String?               @map("reward_id")
  rewardClaimStatus BossRewardClaimStatus @map("reward_claim_status")
  createdAt         DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)
  battle            BossBattle            @relation(fields: [bossBattleId], references: [id], onDelete: Restrict)
  user              Account               @relation(fields: [userId], references: [id], onDelete: Restrict)
  reward            BossBattleReward?     @relation(fields: [rewardId], references: [id], onDelete: Restrict)
  claim             BossRewardClaim?

  @@unique([bossBattleId, userId])
  @@index([bossBattleId, place])
  @@index([userId, createdAt(sort: Desc)])
  @@map("boss_battle_results")
}

model BossRewardClaim {
  id                 String                @id @default(uuid())
  bossBattleId       String                @map("boss_battle_id")
  bossBattleResultId String                @unique @map("boss_battle_result_id")
  bossBattleRewardId String                @map("boss_battle_reward_id")
  userId             String                @map("user_id")
  place              Int
  status             BossRewardClaimStatus
  idempotencyKey     String                @map("idempotency_key")
  rewardSnapshot     Json                  @map("reward_snapshot")
  attemptCount       Int                   @default(1) @map("attempt_count")
  lastError          String?               @map("last_error")
  claimedAt          DateTime?             @map("claimed_at") @db.Timestamptz(3)
  createdAt          DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)
  battle             BossBattle            @relation(fields: [bossBattleId], references: [id], onDelete: Restrict)
  result             BossBattleResult      @relation(fields: [bossBattleResultId], references: [id], onDelete: Restrict)
  reward             BossBattleReward      @relation(fields: [bossBattleRewardId], references: [id], onDelete: Restrict)
  user               Account               @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([bossBattleId, userId])
  @@index([userId, status])
  @@index([bossBattleId, status])
  @@map("boss_reward_claims")
}

model BossBattleAuditLog {
  id           String     @id @default(uuid())
  bossBattleId String     @map("boss_battle_id")
  adminUserId  String     @map("admin_user_id")
  action       String
  beforeData   Json?      @map("before_data")
  afterData    Json?      @map("after_data")
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  battle       BossBattle @relation(fields: [bossBattleId], references: [id], onDelete: Restrict)

  @@index([bossBattleId, createdAt(sort: Desc)])
  @@map("boss_battle_audit_logs")
}

model AuthCode {
  id        String   @id @default(uuid())
  code      String   @unique @db.VarChar(6)
  accountId String   @unique
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
}

model Admin {
  id                       String                      @id @default(uuid())
  singletonKey             String                      @unique @default("singleton")
  username                 String                      @unique
  passwordHash             String
  lastTimeLoggedIn         DateTime?                   @db.Timestamptz(3)
  createdAt                DateTime                    @default(now()) @db.Timestamptz(3)
  updatedAt                DateTime                    @updatedAt @db.Timestamptz(3)
  civilizationGamesCreated CivilizationGame[]          @relation("CivilizationGameCreator")
  civilizationAuditLogs    CivilizationAdminAuditLog[]
}

enum ItemRarity {
  unterlyanskiy
  basic_minimum
  sigma
  bezumnyy
}

model Item {
  id              String     @id @default(uuid())
  ownerUserId     String?    @map("owner_user_id")
  owner           Account?   @relation(fields: [ownerUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  name            String
  description     String?
  imageUrl        String?    @map("image_url")
  strength        Int?
  charisma        Int?
  agility         Int?
  intelligence    Int?
  price           Int
  isListedForSale Boolean    @default(false) @map("is_listed_for_sale")
  listingPrice    Int?       @map("listing_price")
  rarity          ItemRarity
  durability      Int?

  slotType       EquipmentSlotType
  equippedSlot   UserEquipmentSlot?
  purchaseEvents GameEvent[]        @relation("GameEventItem")
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([ownerUserId])
  @@index([isListedForSale, createdAt])
  @@map("items")
}

model UserEquipmentSlot {
  id String @id @default(cuid())

  userId String
  user   Account @relation(fields: [userId], references: [id])

  slotType EquipmentSlotType
  position Int               @default(0)

  itemId String? @unique
  item   Item?   @relation(fields: [itemId], references: [id])

  @@unique([userId, slotType, position])
}

enum TaskType {
  daily
  weekly
  event
}

model Task {
  id                 String           @id @default(uuid())
  type               TaskType
  title              String
  description        String?
  image              String?
  rewardMoney        Int              @map("reward_money")
  rewardGameScore    Int?             @map("reward_game_score")
  rewardAttributes   Json?            @map("reward_attributes")
  requiresProofImage Boolean          @default(false) @map("requires_proof_image")
  submissionLimit    Int?             @map("submission_limit")
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  submissions        TaskSubmission[]
  completedEvents    GameEvent[]      @relation("GameEventCompletedTask")

  @@index([type])
  @@index([createdAt])
  @@map("tasks")
}

model TaskSuggestion {
  id                 String               @id @default(uuid())
  creatorUserId      String               @map("creator_user_id")
  suggestedForDate   DateTime             @map("suggested_for_date") @db.Date
  status             TaskSuggestionStatus @default(pending)
  publishedTaskId    String?              @map("published_task_id")
  type               TaskType
  title              String
  description        String?
  image              String?
  rewardMoney        Int                  @map("reward_money")
  rewardGameScore    Int?                 @map("reward_game_score")
  rewardAttributes   Json?                @map("reward_attributes")
  requiresProofImage Boolean              @default(false) @map("requires_proof_image")
  submissionLimit    Int?                 @map("submission_limit")
  createdAt          DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  processedAt        DateTime?            @map("processed_at") @db.Timestamptz(3)

  creator Account              @relation("TaskSuggestionCreator", fields: [creatorUserId], references: [id], onDelete: Cascade)
  votes   TaskSuggestionVote[]

  @@unique([creatorUserId, suggestedForDate])
  @@index([suggestedForDate, status])
  @@index([creatorUserId])
  @@map("task_suggestions")
}

model TaskSuggestionVote {
  id               String   @id @default(uuid())
  suggestionId     String   @map("suggestion_id")
  voterUserId      String   @map("voter_user_id")
  suggestedForDate DateTime @map("suggested_for_date") @db.Date
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  suggestion TaskSuggestion @relation(fields: [suggestionId], references: [id], onDelete: Cascade)
  voter      Account        @relation("TaskSuggestionVoter", fields: [voterUserId], references: [id], onDelete: Cascade)

  @@unique([suggestionId, voterUserId])
  @@unique([voterUserId, suggestedForDate])
  @@index([voterUserId])
  @@map("task_suggestion_votes")
}

model TaskSubmission {
  id               String   @id @default(uuid())
  taskId           String   @map("task_id")
  userId           String   @map("user_id")
  proofImage       String?  @map("proof_image")
  grantedGameScore Int      @default(0) @map("granted_game_score")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  task           Task       @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user           Account    @relation(fields: [userId], references: [id], onDelete: Cascade)
  completedEvent GameEvent? @relation("GameEventTaskSubmission")

  @@index([taskId])
  @@index([userId])
  @@index([taskId, userId, createdAt])
  @@map("task_submissions")
}

model BattleLog {
  id                     String   @id @default(uuid())
  dailyBattleId          String?  @unique @map("daily_battle_id")
  attackerUserId         String   @map("attacker_user_id")
  defenderUserId         String   @map("defender_user_id")
  attackerPower          Float    @map("attacker_power")
  defenderPower          Float    @map("defender_power")
  attackerWinProbability Float    @map("attacker_win_probability")
  winnerUserId           String   @map("winner_user_id")
  loserUserId            String   @map("loser_user_id")
  transferredCoins       Int      @map("transferred_coins")
  gameScoreReward        Int      @map("game_score_reward")
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  dailyBattle DailyBattle? @relation(fields: [dailyBattleId], references: [id], onDelete: SetNull)
  attacker    Account      @relation("BattleAttacker", fields: [attackerUserId], references: [id], onDelete: Cascade)
  defender    Account      @relation("BattleDefender", fields: [defenderUserId], references: [id], onDelete: Cascade)
  winner      Account      @relation("BattleWinner", fields: [winnerUserId], references: [id], onDelete: Cascade)
  loser       Account      @relation("BattleLoser", fields: [loserUserId], references: [id], onDelete: Cascade)

  @@index([attackerUserId, defenderUserId, createdAt])
  @@index([winnerUserId])
  @@index([loserUserId])
  @@map("battle_logs")
}

model DailyBattle {
  id                String          @id @default(uuid())
  playerOneId       String          @map("player_one_id")
  playerTwoId       String          @map("player_two_id")
  dayStartsAt       DateTime        @map("day_starts_at") @db.Timestamptz(3)
  featuredAttribute BattleAttribute @map("featured_attribute")
  completedAt       DateTime?       @map("completed_at") @db.Timestamptz(3)
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  playerOne Account    @relation("DailyBattlePlayerOne", fields: [playerOneId], references: [id], onDelete: Cascade)
  playerTwo Account    @relation("DailyBattlePlayerTwo", fields: [playerTwoId], references: [id], onDelete: Cascade)
  battleLog BattleLog?

  @@unique([playerOneId, playerTwoId, dayStartsAt])
  @@index([playerOneId, dayStartsAt])
  @@index([playerTwoId, dayStartsAt])
  @@map("daily_battles")
}

model GameEvent {
  id                  String             @id @default(uuid())
  type                GameEventType
  purchaseUserId      String?            @map("purchase_user_id")
  itemId              String?            @map("item_id")
  challengerId        String?            @map("challenger_id")
  opponentId          String?            @map("opponent_id")
  winnerId            String?            @map("winner_id")
  taskCompletedUserId String?            @map("task_completed_user_id")
  taskId              String?            @map("task_id")
  taskSubmissionId    String?            @unique @map("task_submission_id")
  proofImage          String?            @map("proof_image")
  battleResult        BattleEventResult? @map("battle_result")
  gameScoreReward     Int?               @map("game_score_reward")
  goldReward          Int?               @map("gold_reward")
  createdAt           DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)

  purchaseUser      Account?        @relation("GameEventPurchaseUser", fields: [purchaseUserId], references: [id], onDelete: Cascade)
  item              Item?           @relation("GameEventItem", fields: [itemId], references: [id], onDelete: Restrict)
  challenger        Account?        @relation("GameEventChallenger", fields: [challengerId], references: [id], onDelete: Cascade)
  opponent          Account?        @relation("GameEventOpponent", fields: [opponentId], references: [id], onDelete: Cascade)
  winner            Account?        @relation("GameEventWinner", fields: [winnerId], references: [id], onDelete: Cascade)
  taskCompletedUser Account?        @relation("GameEventTaskCompletedUser", fields: [taskCompletedUserId], references: [id], onDelete: Cascade)
  task              Task?           @relation("GameEventCompletedTask", fields: [taskId], references: [id], onDelete: Cascade)
  taskSubmission    TaskSubmission? @relation("GameEventTaskSubmission", fields: [taskSubmissionId], references: [id], onDelete: Cascade)

  @@index([type, createdAt])
  @@index([createdAt])
  @@index([purchaseUserId])
  @@index([itemId])
  @@index([challengerId])
  @@index([opponentId])
  @@index([winnerId])
  @@index([taskCompletedUserId])
  @@index([taskId])
  @@map("game_events")
}

model CivilizationGame {
  id                  String                              @id @default(uuid())
  name                String
  status              CivilizationGameStatus              @default(DRAFT)
  startAt             DateTime                            @map("start_at") @db.Timestamptz(3)
  endAt               DateTime                            @map("end_at") @db.Timestamptz(3)
  completedAt         DateTime?                           @map("completed_at") @db.Timestamptz(3)
  winnerTeamId        String?                             @map("winner_team_id")
  completionReason    CivilizationCompletionReason?       @map("completion_reason")
  settingsJson        Json                                @map("settings_json")
  createdByAdminId    String                              @map("created_by_admin_id")
  stateVersion        Int                                 @default(0) @map("state_version")
  createdAt           DateTime                            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime                            @updatedAt @map("updated_at") @db.Timestamptz(3)
  winnerTeam          CivilizationTeam?                   @relation("CivilizationGameWinner", fields: [winnerTeamId], references: [id], onDelete: SetNull)
  createdByAdmin      Admin                               @relation("CivilizationGameCreator", fields: [createdByAdminId], references: [id], onDelete: Restrict)
  teams               CivilizationTeam[]
  players             CivilizationGamePlayer[]
  tiles               CivilizationTile[]
  spawnPoints         CivilizationSpawnPoint[]
  buildings           CivilizationBuilding[]
  towers              CivilizationTower[]
  teamResources       CivilizationTeamResource[]
  attributeResources  CivilizationTeamAttributeResource[]
  actions             CivilizationAction[]
  events              CivilizationEvent[]
  rewardDistributions CivilizationRewardDistribution[]
  rewardClaims        CivilizationRewardClaim[]
  auditLogs           CivilizationAdminAuditLog[]
  snapshots           CivilizationGameSnapshot[]

  @@index([status, startAt])
  @@index([status, endAt])
  @@index([createdAt(sort: Desc)])
  @@map("civilization_games")
}

model CivilizationTeam {
  id                  String                              @id @default(uuid())
  gameId              String                              @map("game_id")
  name                String
  color               String
  visualIdentifier    String?                             @map("visual_identifier")
  side                CivilizationTeamSide
  townHallTileId      String?                             @unique @map("town_hall_tile_id")
  finalScore          Decimal?                            @map("final_score") @db.Decimal(30, 12)
  createdAt           DateTime                            @default(now()) @map("created_at") @db.Timestamptz(3)
  game                CivilizationGame                    @relation(fields: [gameId], references: [id], onDelete: Cascade)
  townHallTile        CivilizationTile?                   @relation("CivilizationTeamTownHall", fields: [townHallTileId], references: [id], onDelete: SetNull)
  wonGames            CivilizationGame[]                  @relation("CivilizationGameWinner")
  players             CivilizationGamePlayer[]
  ownedTiles          CivilizationTile[]                  @relation("CivilizationTileOwner")
  ownedBuildings      CivilizationBuilding[]              @relation("CivilizationBuildingOwner")
  capturedBuildings   CivilizationBuilding[]              @relation("CivilizationBuildingCaptureTeam")
  towers              CivilizationTower[]
  resources           CivilizationTeamResource[]
  attributeResources  CivilizationTeamAttributeResource[]
  events              CivilizationEvent[]
  rewardDistributions CivilizationRewardDistribution[]
  spawnPoint          CivilizationSpawnPoint?
  rewardClaims        CivilizationRewardClaim[]

  @@unique([gameId, side])
  @@index([gameId])
  @@map("civilization_teams")
}

model CivilizationGamePlayer {
  id                      String                           @id @default(uuid())
  gameId                  String                           @map("game_id")
  teamId                  String                           @map("team_id")
  userId                  String                           @map("user_id")
  initialTileId           String                           @map("initial_tile_id")
  spawnTileId             String                           @map("spawn_tile_id")
  currentTileId           String                           @map("current_tile_id")
  actionPointUnits        Int                              @map("action_point_units")
  lastActionPointUpdateAt DateTime                         @map("last_action_point_update_at") @db.Timestamptz(3)
  joinedAt                DateTime                         @default(now()) @map("joined_at") @db.Timestamptz(3)
  isActive                Boolean                          @default(true) @map("is_active")
  createdAt               DateTime                         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime                         @updatedAt @map("updated_at") @db.Timestamptz(3)
  game                    CivilizationGame                 @relation(fields: [gameId], references: [id], onDelete: Cascade)
  team                    CivilizationTeam                 @relation(fields: [teamId], references: [id], onDelete: Restrict)
  user                    Account                          @relation(fields: [userId], references: [id], onDelete: Restrict)
  initialTile             CivilizationTile                 @relation("CivilizationPlayerInitialTile", fields: [initialTileId], references: [id], onDelete: Restrict)
  spawnTile               CivilizationTile                 @relation("CivilizationPlayerSpawnTile", fields: [spawnTileId], references: [id], onDelete: Restrict)
  currentTile             CivilizationTile                 @relation("CivilizationPlayerCurrentTile", fields: [currentTileId], references: [id], onDelete: Restrict)
  createdTowers           CivilizationTower[]
  actions                 CivilizationAction[]
  actorEvents             CivilizationEvent[]              @relation("CivilizationEventActor")
  targetEvents            CivilizationEvent[]              @relation("CivilizationEventTarget")
  rewardDistributions     CivilizationRewardDistribution[]
  rewardClaims            CivilizationRewardClaim[]

  @@unique([gameId, userId])
  @@index([gameId, teamId, isActive])
  @@index([gameId, currentTileId])
  @@index([userId, createdAt(sort: Desc)])
  @@map("civilization_game_players")
}

model CivilizationTile {
  id              String                   @id @default(uuid())
  gameId          String                   @map("game_id")
  q               Int
  r               Int
  terrainType     CivilizationTerrainType  @default(GROUND) @map("terrain_type")
  ownerTeamId     String?                  @map("owner_team_id")
  isConnected     Boolean                  @default(false) @map("is_connected")
  createdAt       DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)
  game            CivilizationGame         @relation(fields: [gameId], references: [id], onDelete: Cascade)
  ownerTeam       CivilizationTeam?        @relation("CivilizationTileOwner", fields: [ownerTeamId], references: [id], onDelete: SetNull)
  townHallForTeam CivilizationTeam?        @relation("CivilizationTeamTownHall")
  initialPlayers  CivilizationGamePlayer[] @relation("CivilizationPlayerInitialTile")
  spawningPlayers CivilizationGamePlayer[] @relation("CivilizationPlayerSpawnTile")
  currentPlayers  CivilizationGamePlayer[] @relation("CivilizationPlayerCurrentTile")
  spawnPoint      CivilizationSpawnPoint?
  building        CivilizationBuilding?
  towers          CivilizationTower[]
  events          CivilizationEvent[]

  @@unique([gameId, q, r])
  @@index([gameId, ownerTeamId])
  @@index([gameId, isConnected])
  @@index([gameId, terrainType])
  @@map("civilization_tiles")
}

model CivilizationSpawnPoint {
  id        String           @id @default(uuid())
  gameId    String           @map("game_id")
  teamId    String           @unique @map("team_id")
  tileId    String           @unique @map("tile_id")
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  game      CivilizationGame @relation(fields: [gameId], references: [id], onDelete: Cascade)
  team      CivilizationTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)
  tile      CivilizationTile @relation(fields: [tileId], references: [id], onDelete: Cascade)

  @@unique([gameId, teamId])
  @@index([gameId, teamId])
  @@map("civilization_spawn_points")
}

model CivilizationBuilding {
  id                   String                     @id @default(uuid())
  gameId               String                     @map("game_id")
  tileId               String                     @unique @map("tile_id")
  buildingType         CivilizationBuildingType   @map("building_type")
  attributeKey         CivilizationAttributeKey?  @map("attribute_key")
  ownerTeamId          String?                    @map("owner_team_id")
  captureTeamId        String?                    @map("capture_team_id")
  captureProgressUnits Int                        @default(0) @map("capture_progress_units")
  captureRequiredUnits Int                        @map("capture_required_units")
  incomePerHour        Decimal                    @map("income_per_hour") @db.Decimal(30, 12)
  status               CivilizationBuildingStatus @default(ACTIVE)
  createdAt            DateTime                   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(3)
  game                 CivilizationGame           @relation(fields: [gameId], references: [id], onDelete: Cascade)
  tile                 CivilizationTile           @relation(fields: [tileId], references: [id], onDelete: Cascade)
  ownerTeam            CivilizationTeam?          @relation("CivilizationBuildingOwner", fields: [ownerTeamId], references: [id], onDelete: SetNull)
  captureTeam          CivilizationTeam?          @relation("CivilizationBuildingCaptureTeam", fields: [captureTeamId], references: [id], onDelete: SetNull)

  @@index([gameId, buildingType])
  @@index([gameId, ownerTeamId])
  @@index([gameId, captureTeamId])
  @@map("civilization_buildings")
}

model CivilizationTower {
  id                      String                     @id @default(uuid())
  gameId                  String                     @map("game_id")
  teamId                  String                     @map("team_id")
  tileId                  String                     @map("tile_id")
  status                  CivilizationTowerStatus    @default(UNDER_CONSTRUCTION)
  workKind                CivilizationTowerWorkKind? @map("work_kind")
  protectionRadius        Int                        @map("protection_radius")
  hitPoints               Int                        @default(100) @map("hit_points")
  maximumHitPoints        Int                        @default(100) @map("maximum_hit_points")
  constructionStartedAt   DateTime                   @map("construction_started_at") @db.Timestamptz(3)
  constructionCompletesAt DateTime?                  @map("construction_completes_at") @db.Timestamptz(3)
  destroyedAt             DateTime?                  @map("destroyed_at") @db.Timestamptz(3)
  createdByPlayerId       String?                    @map("created_by_player_id")
  createdAt               DateTime                   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(3)
  game                    CivilizationGame           @relation(fields: [gameId], references: [id], onDelete: Cascade)
  team                    CivilizationTeam           @relation(fields: [teamId], references: [id], onDelete: Restrict)
  tile                    CivilizationTile           @relation(fields: [tileId], references: [id], onDelete: Restrict)
  createdByPlayer         CivilizationGamePlayer?    @relation(fields: [createdByPlayerId], references: [id], onDelete: SetNull)

  @@index([gameId, teamId, status])
  @@index([gameId, tileId, status])
  @@index([status, constructionCompletesAt])
  @@map("civilization_towers")
}

model CivilizationTeamResource {
  id                String           @id @default(uuid())
  gameId            String           @map("game_id")
  teamId            String           @map("team_id")
  goldAmount        Decimal          @default(0) @map("gold_amount") @db.Decimal(30, 12)
  goldIncomePerHour Decimal          @default(0) @map("gold_income_per_hour") @db.Decimal(30, 12)
  lastSettledAt     DateTime         @map("last_settled_at") @db.Timestamptz(3)
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  game              CivilizationGame @relation(fields: [gameId], references: [id], onDelete: Cascade)
  team              CivilizationTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([gameId, teamId])
  @@index([teamId])
  @@map("civilization_team_resources")
}

model CivilizationTeamAttributeResource {
  id            String                   @id @default(uuid())
  gameId        String                   @map("game_id")
  teamId        String                   @map("team_id")
  attributeKey  CivilizationAttributeKey @map("attribute_key")
  amount        Decimal                  @default(0) @db.Decimal(30, 12)
  incomePerHour Decimal                  @default(0) @map("income_per_hour") @db.Decimal(30, 12)
  lastSettledAt DateTime                 @map("last_settled_at") @db.Timestamptz(3)
  createdAt     DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)
  game          CivilizationGame         @relation(fields: [gameId], references: [id], onDelete: Cascade)
  team          CivilizationTeam         @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([gameId, teamId, attributeKey], map: "civilization_team_attribute_resources_game_id_team_id_attribute")
  @@index([teamId, attributeKey])
  @@map("civilization_team_attribute_resources")
}

model CivilizationAction {
  id             String                 @id @default(uuid())
  gameId         String                 @map("game_id")
  playerId       String                 @map("player_id")
  idempotencyKey String                 @map("idempotency_key")
  actionType     CivilizationActionType @map("action_type")
  requestPayload Json                   @map("request_payload")
  resultPayload  Json                   @map("result_payload")
  createdAt      DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  game           CivilizationGame       @relation(fields: [gameId], references: [id], onDelete: Restrict)
  player         CivilizationGamePlayer @relation(fields: [playerId], references: [id], onDelete: Restrict)

  @@unique([gameId, playerId, idempotencyKey])
  @@index([gameId, createdAt(sort: Desc)])
  @@index([playerId, createdAt(sort: Desc)])
  @@map("civilization_actions")
}

model CivilizationEvent {
  id             String                  @id @default(uuid())
  gameId         String                  @map("game_id")
  teamId         String?                 @map("team_id")
  actorPlayerId  String?                 @map("actor_player_id")
  targetPlayerId String?                 @map("target_player_id")
  tileId         String?                 @map("tile_id")
  eventType      CivilizationEventType   @map("event_type")
  payloadJson    Json                    @map("payload_json")
  createdAt      DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  game           CivilizationGame        @relation(fields: [gameId], references: [id], onDelete: Restrict)
  team           CivilizationTeam?       @relation(fields: [teamId], references: [id], onDelete: SetNull)
  actorPlayer    CivilizationGamePlayer? @relation("CivilizationEventActor", fields: [actorPlayerId], references: [id], onDelete: SetNull)
  targetPlayer   CivilizationGamePlayer? @relation("CivilizationEventTarget", fields: [targetPlayerId], references: [id], onDelete: SetNull)
  tile           CivilizationTile?       @relation(fields: [tileId], references: [id], onDelete: SetNull)

  @@index([gameId, createdAt(sort: Desc), id])
  @@index([gameId, eventType, createdAt(sort: Desc)])
  @@index([actorPlayerId, createdAt(sort: Desc)])
  @@map("civilization_events")
}

model CivilizationRewardDistribution {
  id              String                         @id @default(uuid())
  gameId          String                         @map("game_id")
  teamId          String                         @map("team_id")
  playerId        String                         @map("player_id")
  resourceType    CivilizationRewardResourceType @map("resource_type")
  attributeKey    CivilizationAttributeKey?      @map("attribute_key")
  amount          Int
  roundingDetails Json                           @map("rounding_details")
  appliedAt       DateTime?                      @map("applied_at") @db.Timestamptz(3)
  createdAt       DateTime                       @default(now()) @map("created_at") @db.Timestamptz(3)
  game            CivilizationGame               @relation(fields: [gameId], references: [id], onDelete: Restrict)
  team            CivilizationTeam               @relation(fields: [teamId], references: [id], onDelete: Restrict)
  player          CivilizationGamePlayer         @relation(fields: [playerId], references: [id], onDelete: Restrict)

  @@index([gameId, teamId])
  @@index([playerId, appliedAt])
  @@map("civilization_reward_distributions")
}

model CivilizationRewardClaim {
  id               String                   @id @default(uuid())
  gameId           String                   @map("game_id")
  teamId           String                   @map("team_id")
  playerId         String                   @map("player_id")
  eligible         Boolean
  unavailableReason String?                 @map("unavailable_reason")
  rewardJson       Json                     @map("reward_json")
  expiresAt        DateTime?                @map("expires_at") @db.Timestamptz(3)
  claimedAt        DateTime?                @map("claimed_at") @db.Timestamptz(3)
  createdAt        DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)
  game             CivilizationGame         @relation(fields: [gameId], references: [id], onDelete: Restrict)
  team             CivilizationTeam         @relation(fields: [teamId], references: [id], onDelete: Restrict)
  player           CivilizationGamePlayer   @relation(fields: [playerId], references: [id], onDelete: Restrict)

  @@unique([gameId, playerId])
  @@index([playerId, claimedAt])
  @@map("civilization_reward_claims")
}

model CivilizationAdminAuditLog {
  id         String                      @id @default(uuid())
  gameId     String                      @map("game_id")
  adminId    String                      @map("admin_id")
  action     CivilizationAdminActionType
  beforeData Json?                       @map("before_data")
  afterData  Json?                       @map("after_data")
  metadata   Json?
  createdAt  DateTime                    @default(now()) @map("created_at") @db.Timestamptz(3)
  game       CivilizationGame            @relation(fields: [gameId], references: [id], onDelete: Restrict)
  admin      Admin                       @relation(fields: [adminId], references: [id], onDelete: Restrict)

  @@index([gameId, createdAt(sort: Desc)])
  @@index([adminId, createdAt(sort: Desc)])
  @@map("civilization_admin_audit_logs")
}

model CivilizationGameSnapshot {
  id           String                       @id @default(uuid())
  gameId       String                       @map("game_id")
  snapshotType CivilizationGameSnapshotType @map("snapshot_type")
  stateJson    Json                         @map("state_json")
  createdAt    DateTime                     @default(now()) @map("created_at") @db.Timestamptz(3)
  game         CivilizationGame             @relation(fields: [gameId], references: [id], onDelete: Restrict)

  @@unique([gameId, snapshotType])
  @@index([gameId, createdAt(sort: Desc)])
  @@map("civilization_game_snapshots")
}
